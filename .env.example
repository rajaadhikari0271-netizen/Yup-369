# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Private Owner / Super Admin Portal Credentials (server-side only; never prefix with VITE_)
OWNER_ADMIN_EMAIL=
OWNER_ADMIN_PASSCODE=

# Optional Supabase Connection (client-safe anon credentials for Supabase-ready repository adapter)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
